# Copy to .env and fill in.

# ─── LLM (OpenRouter free tier) ────────────────────────────────────
# Sign up at https://openrouter.ai (free), generate a key at
# https://openrouter.ai/keys, then paste it below.
# If left blank, the system falls back to rule-based templates for
# all 3 agents (alert, case, explanation) — the demo still works.
OPENROUTER_API_KEY=
# Optional: override the default free model
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Optional: override the default 10s timeout
# OPENROUTER_TIMEOUT=10

